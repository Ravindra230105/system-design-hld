          <mxGeometry x="690" y="150" width="210" height="620" as="geometry" />
        </mxCell>

        <mxCell id="ktopic1" value="critical-topic&#10;partitioned by userId&#10;(~100+ partitions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="200" width="170" height="80" as="geometry" />
