<mxfile host="app.diagrams.net" modified="2026-09-25T00:00:00.000Z" agent="claude-code" version="24.0.0">
  <diagram id="notif-hld" name="Notification System - HLD">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Notification System — High Level Design" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="620" height="40" as="geometry" />
        </mxCell>

        <!-- ============ CLIENTS ============ -->
        <mxCell id="client" value="Client App / Backend&#10;(tenant sending notifications)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- ============ GATEWAY ============ -->
        <mxCell id="gw" value="API Gateway&#10;• API key auth&#10;• per-client rate limit&#10;• request validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="290" width="150" height="90" as="geometry" />
        </mxCell>

        <!-- ============ SERVICES ============ -->
        <mxCell id="notifsvc" value="Notification Service&#10;(critical write path)&#10;• validate + template&#10;• idempotency check&#10;• persist + produce&#10;• returns 202" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="170" width="170" height="120" as="geometry" />
        </mxCell>

        <mxCell id="campsvc" value="Campaign Service&#10;(promotional write path)&#10;• store campaign&#10;• segment definition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="430" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sched" value="Campaign Scheduler&#10;(cron / every 1 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="560" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fanout" value="Fanout Service&#10;• resolve segment → userIds&#10;• chunk (1k users/batch)&#10;• lookup device tokens&#10;• filter by preferences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
