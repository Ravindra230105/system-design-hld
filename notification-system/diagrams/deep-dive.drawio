<mxfile host="app.diagrams.net" modified="2026-09-25T00:00:00.000Z" agent="claude-code" version="24.0.0">
  <diagram id="notif-dd" name="Notification System - Deep Dives">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Notification System — Deep Dives" style="text;html=1;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- ======== 1. AT LEAST ONCE ======== -->
        <mxCell id="b1" value="1. At-least-once delivery (critical)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="760" height="260" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Notification Svc&#10;1. write DB row&#10;2. produce to Kafka&#10;3. THEN ack 202" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Kafka&#10;critical-topic&#10;(durable log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="155" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Worker&#10;send → provider ACK&#10;→ commit offset&#10;(manual commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="150" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Redis&#10;idempotencyKey&#10;TTL 24h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="155" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Crash before commit → message re-delivered (duplicate possible).&#10;Dedupe with idempotencyKey + APNs collapse-id / FCM collapse_key.&#10;Exactly-once is impossible — the last hop is a 3rd party." style="text;html=1;fontSize=11;align=left;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="710" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ======== 2. RETRY / DLQ ======== -->
        <mxCell id="b2" value="2. Provider failure: retry, circuit breaker, DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="90" width="800" height="260" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Channel Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="160" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Circuit Breaker" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="145" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Provider&#10;(APNs / SES / Twilio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="160" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="retry topics&#10;5s → 30s → 5m&#10;(exp backoff + jitter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="255" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="DLQ&#10;manual replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1450" y="260" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="permanent error (400,&#10;invalid token, unsub)&#10;→ delete device row,&#10;NEVER retry" style="text;html=1;fontSize=10;align=left;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1450" y="150" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" value="closed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" value="5xx / 429 / timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4" value="after N attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce5" value="re-consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="c4" target="c1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1205" y="290" /><mxPoint x="935" y="290" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ======== 3. LANE ISOLATION / SLA ======== -->
        <mxCell id="b3" value="3. &lt; 5s SLA — separate lanes for critical vs promotional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="760" height="300" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="CRITICAL LANE&#10;critical-topic → dedicated consumer group&#10;→ over-provisioned worker pool&#10;→ persistent HTTP/2 conns to APNs/FCM&#10;→ token cache in Redis (no DB on hot path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="PROMOTIONAL LANE&#10;promotional-topic → own consumer group&#10;→ throttled worker pool&#10;→ deliberately rate-capped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Latency budget:  API ~10ms  →  queue lag &lt; 1s  →  worker + provider ~1–2s  →  headroom&#10;&#10;The SLA is a QUEUE LAG problem, not a code problem:&#10;alert + autoscale on consumer lag of critical-topic, not on CPU." style="text;html=1;fontSize=11;align=left;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="570" width="700" height="100" as="geometry" />
        </mxCell>

        <!-- ======== 4. SCALE ======== -->
        <mxCell id="b4" value="4. Scaling to 800k critical + 200k promotional / sec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="390" width="800" height="300" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="Kafka topic — partitioned by hash(userId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="870" y="440" width="740" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="P0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="890" y="470" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="P1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="470" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="P2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1070" y="470" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="…" style="text;html=1;align=center;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1160" y="470" width="50" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="P99+" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="470" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="~10k msg/sec per partition&#10;⇒ 1M/sec needs 100+ partitions&#10;one consumer per partition,&#10;workers are stateless" style="text;html=1;fontSize=10;align=left;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1320" y="460" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="Storage split:&#10;• notifications + delivery_attempts → Cassandra/DynamoDB, PK userId, TTL 30d  (append-only, write-heavy)&#10;• templates + campaign config → Postgres  (low volume, relational)&#10;• Geographic sharding: route a user to their nearest region — also cuts RTT to regional provider endpoints&#10;• Partition key = userId ⇒ per-user ordering preserved ('new message' can't arrive after 'message deleted')" style="text;html=1;fontSize=11;align=left;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="870" y="575" width="740" height="100" as="geometry" />
        </mxCell>

        <!-- ======== 5. THROTTLING ======== -->
        <mxCell id="b5" value="5. Multi-level throttling — noisy neighbour isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="760" height="240" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="① API Gateway&#10;per-client quota&#10;(token bucket in Redis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="790" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="② Fanout Service&#10;per-campaign send rate cap&#10;(100M users drain over minutes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="790" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="③ Channel Worker&#10;provider rate limit&#10;(e.g. SES 14/sec)&#10;shared Redis counter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="550" y="790" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="Without per-tenant quotas, one client's campaign eats the shared worker pool&#10;and silently breaks every other client's SLA." style="text;html=1;fontSize=11;align=left;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="890" width="690" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ge1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ======== 6. PREFERENCES + STATUS ======== -->
        <mxCell id="b6" value="6 &amp; 7. Preferences / quiet hours  +  delivery status feedback loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="730" width="800" height="240" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="Fanout Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="790" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="Preference Service&#10;(Redis-cached)&#10;quiet hours, opt-outs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="780" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="filter BEFORE producing&#10;to Kafka — never queue&#10;a message you'll drop.&#10;CRITICAL bypasses prefs." style="text;html=1;fontSize=10;align=left;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1240" y="775" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="Provider webhooks&#10;delivered / bounced / complained" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="890" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="Status Consumer&#10;→ update delivery_attempts&#10;→ suppress hard bounces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="885" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="h6" value="SENT ≠ delivered.&#10;APNs/FCM never confirm&#10;the user saw it — expose&#10;what the provider reports." style="text;html=1;fontSize=10;align=left;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1370" y="880" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="he1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="he2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="he3" value="feeds back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="h5" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
